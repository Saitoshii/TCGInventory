[Unit]
Description=TCGInventory – verschlüsseltes Backup nach OneDrive
Documentation=file:///home/pi/TCGInventory/docs/BACKUP.md
# Ohne Netz kein Upload – der Timer holt den Lauf dann später nach.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/home/pi/TCGInventory

# Pfade und Ziel stehen ausschließlich hier, nie im Repository.
# Datei mit 600 anlegen: sudo install -m 600 /dev/null /etc/tcginventory-backup.env
EnvironmentFile=/etc/tcginventory-backup.env

ExecStart=/usr/bin/python3 /home/pi/TCGInventory/scripts/backup.py

# Der Pi soll durch das Backup nicht ausgebremst werden.
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3600

# Etwas Härtung – das Skript braucht nur sein Arbeitsverzeichnis.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/pi/TCGInventory/data

[Install]
WantedBy=multi-user.target
