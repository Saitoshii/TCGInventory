# Vorlage für /etc/tcginventory-backup.env
#
# Diese Datei ist nur ein BEISPIEL und enthält bewusst keine Zugangsdaten.
# Auf dem Pi anlegen und mit 600 schützen:
#
#   sudo install -m 600 /dev/null /etc/tcginventory-backup.env
#   sudo nano /etc/tcginventory-backup.env
#
# Die echte Datei liegt außerhalb des Repositories und wird nie eingecheckt.

# Ziel: das crypt-Remote über OneDrive (siehe docs/BACKUP.md).
TCG_BACKUP_REMOTE=onedrive-crypt:

# rclone-Konfiguration (selbst passwortgeschützt) und die Datei mit dem
# Konfigurationspasswort – beide mit Rechten 600, außerhalb des Repos.
TCG_RCLONE_CONFIG=/home/pi/.config/rclone/rclone.conf
TCG_RCLONE_CONFIG_PASS_FILE=/home/pi/.config/rclone/config.pass

# Optional – die Standardwerte passen für die übliche Installation.
#TCG_BACKUP_ROOT=/home/pi/TCGInventory
#TCG_BACKUP_DATA_DIR=/home/pi/TCGInventory/data
#TCG_BACKUP_WORK_DIR=/home/pi/TCGInventory/data/backup_work
#TCG_BACKUP_STATUS_FILE=/home/pi/TCGInventory/data/backup_status.json
#TCG_BACKUP_LOG_FILE=/home/pi/TCGInventory/data/backup.log
#TCG_RCLONE_BIN=/usr/bin/rclone

# Aufbewahrung: 7 Tagesstände + 12 Monatsstände.
#TCG_BACKUP_KEEP_DAILY=7
#TCG_BACKUP_KEEP_MONTHLY=12

# Datenverzeichnis der eigenstaendigen Buchhaltung. Ist es gesetzt,
# werden deren Datenbank und Belege mitgesichert. Dieselbe Variable
# benutzt auch die Buchhaltung selbst.
# BUCH_DATA_DIR=/home/pi/buchhaltung-daten
